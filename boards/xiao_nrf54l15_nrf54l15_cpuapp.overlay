#include <zephyr/dt-bindings/sensor/bmp581.h>
#include <zephyr/dt-bindings/sensor/lsm6dso.h>

/ {
	aliases {
		pressure-sensor = &bmp581;
		imu-sensor = &lsm6dso;
	};
};

/* Disable the reference-board IMU node; this design uses an external LSM6DSO. */
&lsm6ds3tr_c {
	status = "disabled";
};

/* P0.04 = SDA, P0.03 = SCL on this board definition. */
&i2c30 {
	status = "okay";

	bmp581: bmp581@46 {
		compatible = "bosch,bmp581";
		reg = <0x46>;
		odr = <BMP581_DT_ODR_50_HZ>;
		press-osr = <BMP581_DT_OVERSAMPLING_8X>;
		temp-osr = <BMP581_DT_OVERSAMPLING_2X>;
		press-iir = <BMP581_DT_IIR_FILTER_COEFF_7>;
		temp-iir = <BMP581_DT_IIR_FILTER_COEFF_3>;
		power-mode = <BMP581_DT_MODE_NORMAL>;
		status = "okay";
	};

	lsm6dso: lsm6dso@6a {
		compatible = "st,lsm6dso";
		reg = <0x6a>;
		status = "okay";
	};
};
